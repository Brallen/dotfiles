{
  "toolbar": {
    "agent_review": true,
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },
  "title_bar": {
    "show_menus": false,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "show_wrap_guides": true,
  "tabs": {
    "close_position": "right",
    "git_status": true,
  },
  "debugger": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "indent_guides": {
      "show": "always",
    },
    "git_status_indicator": true,
    "indent_size": 10.0,
    "dock": "left",
  },
  "ui_font_size": 15.0,
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "diff_view_style": "unified",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "which_key": {
    "enabled": true,
  },
  "base_keymap": "VSCode",
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "colorize_brackets": true,
  "helix_mode": false,
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  "show_edit_predictions": true,
  "agent": {
    "flexible": false,
    "sidebar_side": "left",
    "dock": "right",
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-opus-4-6-latest",
        "enable_thinking": false,
      },
    ],
    "tool_permissions": {
      "default": "allow",
    },
    "notify_when_agent_waiting": "never",
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-5-thinking-latest",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest",
    },
  },
  "theme": "Everforest Dark Hard (material)",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 14,
  "tab_size": 2,
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "always_treat_brackets_as_autoclosed": false,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "terminal": {
    "flexible": false,
    "cursor_shape": "bar",
    "dock": "right",
    "blinking": "on",
    "copy_on_select": true,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 14,
    "env": {
      "GIT_EDITOR": "zed --wait",
    },
  },
  "lsp": {
    "typescript-language-server": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
          },
        },
      },
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": "./oxlint.config.mts",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "run": "onSave",
          "unusedDisableDirectives": "deny",
        },
      },
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": "./oxfmt.config.mts",
          "run": "onSave",
        },
      },
    },
    // "tsgo": {
    //   "settings": {
    //     "typescript": {
    //       "preferences": {
    //         "importModuleSpecifier": "non-relative",
    //       },
    //     },
    //   },
    // },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
          },
        },
      },
    },
    "hls": {
      "binary": {
        "path": "./.bin/static-ls",
        // Zed does not respawn an exited language server, so static-ls's
        // default 120-minute self-restart leaves it permanently dead.
        "arguments": [
          "--experimentalFeatures",
          "--fourmoluCommand=fourmolu",
          "--restartInterval=0",
        ],
      },
      "initialization_options": {
        "haskell": {
          "formattingProvider": "fourmolu",
        },
      },
    },
  },
  "language_servers": ["vtsls", "!typescript-language-server","..."],
  "languages": {
    "Haskell": {
      "format_on_save": "off",
      "show_edit_predictions": true,
    },
    "CSS": {
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
      "show_edit_predictions": true,
    },
    "TypeScript": {
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "show_edit_predictions": true,
    },
    "TSX": {
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "show_edit_predictions": true,
    },
  },
}
